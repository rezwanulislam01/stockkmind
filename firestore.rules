rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection test document for healthcheck
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // User Profile
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if false;

      // Products subcollection
      match /products/{productId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(productId);
      }

      // Purchase Orders subcollection
      match /purchaseOrders/{poId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(poId);
      }

      // Action Queue subcollection
      match /actionQueue/{actionId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(actionId);
      }
    }
  }
}
